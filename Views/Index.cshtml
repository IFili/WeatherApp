@model List<WeatherApp.Models.User>
@{
    ViewData["Title"]="Home Page";
}

    <table class="table ">
        <thead>
            <tr>
                <th>Id</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>User</th>
                <th>Password</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr>
                    <td>@item.Id</td> 
                    <td>@item.FirstName</td> 
                    <td>@item.LastName</td> 
                    <td>@item.Username</td> 
                    <td>@item.Password</td> 
                        </tr>
            }
        </tbody>
    </table>